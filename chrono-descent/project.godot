; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ChronoDescent"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*uid://ryw6eajh4x5c"
Run="*res://scripts/run/run_state.gd"
Music="*res://scripts/music_manager.gd"
Audio="*res://scripts/audio_manager.gd"
InputHints="*res://scripts/input_hints.gd"

[debug]

gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/unused_signal=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/shadowed_global_identifier=0
gdscript/warnings/standalone_ternary=0
gdscript/warnings/integer_division=0
gdscript/warnings/int_as_enum_without_cast=0

[display]

window/size/mode=3
window/stretch/mode="viewport"

