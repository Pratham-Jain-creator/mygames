extends Node3D
## Streamed dungeon of ~50 hand-designed rooms (scenes/levels/rooms/*.tscn, generated by tools/gen_rooms.py).
## Rooms are chained with transforms, so the dungeon can TURN: a corner room exits through its side wall and
## the next room is placed rotated by 90 degrees (Transform3D chaining). Only rooms near the player
## (and back to the last checkpoint) exist at once.
##
## Each room: entry at its local origin facing -Z, exit at its far end (straight) or through the side wall (corner).
## Solved rooms (all seals broken) stay open even if they are streamed out and back in.

const Catalog = preload("res://scripts/room_catalog.gd")

@export var room_count := 120
@export var seed_value := 7
@export var ahead := 4
@export var behind := 2

const SPECIAL := {
	"start": {"path": "res://scenes/levels/chunks/start.tscn", "len": 12.0, "turn": 0},
	"shrine": {"path": "res://scenes/levels/chunks/shrine.tscn", "len": 24.0, "turn": 0},
	"final": {"path": "res://scenes/levels/chunks/final.tscn", "len": 28.0, "turn": 0},
}
const SHRINE_EVERY := 5
const CORNER_SIZE := 12.0

var plan: Array[Dictionary] = []  # {path, len, turn, xf, depth, name}
var total_len := 0.0
var live: Dictionary = {}
var scenes: Dictionary = {}
var solved: Dictionary = {}
var player: Node3D = null
var cur_idx := 0
var cp_idx := 0
var _cp_seen := Vector3.INF
var _accum := 0.0
var _bags: Dictionary = {}
var _rng := RandomNumberGenerator.new()


func _ready() -> void:
	Game.run_time = 0.0
	Game.run_active = true
	_build_plan()
	Game.depth_total = total_len
	_sync_rooms(0, ahead)


# --- planning ---------------------------------------------------------------------
func _bag_pick(key: String, source: Array[String]) -> String:
	var bag: Array = _bags.get(key, [])
	if bag.is_empty():
		bag = source.duplicate()
		for i in range(bag.size() - 1, 0, -1):  # Fisher-Yates
			var j := _rng.randi_range(0, i)
			var tmp = bag[i]
			bag[i] = bag[j]
			bag[j] = tmp
	var pick: String = bag.pop_back()
	_bags[key] = bag
	return pick


func _entry(room_name: String) -> Dictionary:
	if SPECIAL.has(room_name):
		var s: Dictionary = SPECIAL[room_name]
		return {"name": room_name, "path": s["path"], "len": s["len"], "turn": 0}
	var r: Dictionary = Catalog.ROOMS[room_name]
	return {"name": room_name, "path": "res://scenes/levels/rooms/%s.tscn" % room_name, "len": r["len"], "turn": r["turn"]}


func _build_plan() -> void:
	_rng.seed = seed_value
	plan.append(_entry("start"))
	var corner_sign := 1  # first corner turns left (-1), then right, alternating -> path never folds back on itself
	var since_corner := 99
	var last_kind := ""
	for i in range(1, room_count - 1):
		if i % SHRINE_EVERY == 0:
			plan.append(_entry("shrine"))
			since_corner += 1
			continue
		var kind := ""
		var roll := _rng.randf()
		if since_corner >= 2 and roll < 0.22:
			kind = "corner"
		elif roll < 0.55:
			kind = "parkour"
		elif roll < 0.77:
			kind = "fight"
		else:
			kind = "key"
		if kind == last_kind and kind != "corner" and _rng.randf() < 0.7:
			kind = ["parkour", "fight", "key"][_rng.randi_range(0, 2)]
		var pick := ""
		match kind:
			"corner":
				corner_sign = -corner_sign
				if corner_sign < 0:
					pick = _bag_pick("cl", Catalog.CORNERS_LEFT)
				else:
					pick = _bag_pick("cr", Catalog.CORNERS_RIGHT)
				since_corner = 0
			"parkour":
				pick = _bag_pick("p", Catalog.PARKOUR)
				since_corner += 1
			"fight":
				pick = _bag_pick("f", Catalog.FIGHT)
				since_corner += 1
			_:
				pick = _bag_pick("k", Catalog.KEY)
				since_corner += 1
		last_kind = kind
		plan.append(_entry(pick))
	plan.append(_entry("final"))
	# a left corner without its right partner would leave the final room off-axis; that's fine, it's the end.
	var xf := Transform3D.IDENTITY
	var depth := 0.0
	for e in plan:
		e["xf"] = xf
		e["depth"] = depth
		depth += float(e["len"])
		xf = xf * _exit_xf(e)
	total_len = depth
	for e in plan:
		if not scenes.has(e["path"]):
			scenes[e["path"]] = load(e["path"])


## Transform from a room's origin to the next room's origin.
func _exit_xf(e: Dictionary) -> Transform3D:
	var turn: int = e["turn"]
	if turn == 0:
		return Transform3D(Basis.IDENTITY, Vector3(0.0, 0.0, -float(e["len"])))
	# left turn (turn = -1): yaw +90 deg, exit through x = -6; right turn mirrors it
	return Transform3D(Basis(Vector3.UP, -turn * PI * 0.5), Vector3(turn * CORNER_SIZE * 0.5, 0.0, -CORNER_SIZE * 0.5))


# --- streaming ----------------------------------------------------------------------
func _process(delta: float) -> void:
	_accum += delta
	if _accum < 0.15:
		return
	_accum = 0.0
	if not is_instance_valid(player):
		player = get_tree().get_first_node_in_group("player") as Node3D
		return
	cur_idx = _index_for_pos(player.global_position, cur_idx)
	var e: Dictionary = plan[cur_idx]
	var local: Vector3 = (e["xf"] as Transform3D).affine_inverse() * player.global_position
	Game.depth = clampf(float(e["depth"]) + clampf(-local.z, 0.0, float(e["len"])), 0.0, total_len)
	if Game.checkpoint_pos != _cp_seen:
		_cp_seen = Game.checkpoint_pos
		cp_idx = _index_for_pos(_cp_seen, cur_idx)
	var lo := maxi(0, mini(cur_idx - behind, cp_idx - 1))
	_sync_rooms(lo, cur_idx + ahead)


func _contains(i: int, pos: Vector3) -> bool:
	var e: Dictionary = plan[i]
	var local: Vector3 = (e["xf"] as Transform3D).affine_inverse() * pos
	return local.z > -float(e["len"]) - 1.0 and local.z < 1.5 and absf(local.x) < 8.0


## Which room holds pos. Looks near `hint` first, then falls back to the nearest room centre.
func _index_for_pos(pos: Vector3, hint: int) -> int:
	hint = clampi(hint, 0, plan.size() - 1)
	for d in [0, 1, -1, 2, -2, 3, -3]:
		var i: int = hint + d
		if i >= 0 and i < plan.size() and _contains(i, pos):
			return i
	var best := hint
	var best_d := INF
	for i in plan.size():
		var e: Dictionary = plan[i]
		var centre: Vector3 = (e["xf"] as Transform3D) * Vector3(0.0, 0.0, -float(e["len"]) * 0.5)
		var dist := centre.distance_squared_to(pos)
		if dist < best_d:
			best_d = dist
			best = i
	return best


func _sync_rooms(lo: int, hi: int) -> void:
	hi = mini(hi, plan.size() - 1)
	for idx in live.keys():
		if idx < lo or idx > hi:
			live[idx].queue_free()
			live.erase(idx)
	for i in range(lo, hi + 1):
		if live.has(i):
			continue
		var room: Node3D = scenes[plan[i]["path"]].instantiate()
		room.transform = plan[i]["xf"]
		add_child(room)
		live[i] = room
		if room.has_signal("solved"):
			room.solved.connect(_on_room_solved.bind(i))
			if solved.has(i):
				room.call_deferred("force_open")


func _on_room_solved(i: int) -> void:
	solved[i] = true
