; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="VectorOps"
run/main_scene="res://scenes/core/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/images/icon/vector_ops_icon/icon.svg"
config/windows_native_icon="res://assets/images/icon/vector_ops_icon/icon.ico"

[autoload]

GameState="*res://scripts/core/game_state.gd"
AudioDirector="*res://scripts/core/audio_director.gd"

[display]

window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

